{% extends 'base.html.twig' %}

{% block title %}Hello DuckDuckJumpController!{% endblock %}

{% block body %}
{% include 'includes/header.html.twig' %}
    <div class="container game-container py-3">
        <head>
            <link rel="stylesheet" href="{{ asset('styles/duck_duck_jump.css') }}"></link>
        </head>

        <header class="d-flex justify-content-between align-items-center mb-4">
            <div>
                <h1 class="font-bagel text-warning m-0 fs-2">Duck Duck Jump</h1>
            </div>
            <a href="{{ path('app_duck_duck_jump_leaderboard') }}">
                <button>Voir le classement</button>
            </a>
        </header>

        <div class="row g-4">
        <div class="canvas-wrapper col-lg-8">
            <div class="p-3 text-start multiplier-container">
                <div class="mb-2">
                    Multiplieur de gain : <span id="multiplier" class="multiplier-badge">X0</span>
                </div>

                <canvas id="canvas" width="500" height="400" data-rive-url="{{ asset('rive/duck_animations.riv') }}"></canvas>
            </div>
        </div>
        
        
        <p>Votre solde actuelle est de <span id="balance">{{ userBalance }}</span>€</p>
        <p>Miser une somme : <input type="number" label="betAmount" id="betAmount"></p>

        <div id="controls">
            <button id="play">Commencer une partie</button>
        </div>
    </div>
    <script src="https://unpkg.com/@rive-app/webgl2@latest"></script>
    <script src=" {{ asset('script/duckduckjump.js') }} "></script>
{% endblock %}
