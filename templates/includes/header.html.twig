<head>
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Bagel+Fat+One&display=swap" rel="stylesheet">
    <link href="https://fonts.googleapis.com/css2?family=Quicksand:wght@300..700" rel="stylesheet">
</head>

<header>
    <div class="container navigation-bar">
        <div class="col profile-avatar-container">
            <a href=" {{ path('app_user') }} ">
                {% if (app.user) %}
                    <img src="{{ '/uploads/profiles/' ~ app.user.image }}" alt="profile">
                {% else %}
                    <img src="https://img.magnific.com/vecteurs-premium/illustration-vectorielle-plate-echelle-gris-avatar-profil-utilisateur-icone-personne-image-profil-silhouette-neutre-genre-convient-pour-profils-medias-sociaux-icones-economiseurs-ecran-comme-modelex9_719432-3434.jpg?semt=ais_hybrid&w=740&q=80">
                {% endif %}
            </a>
        </div>
        <div class="col nav-buttons">
            {% if app.request.attributes.get('_route') != 'app_home'%}
                <a href="{{ path('app_home') }}"><button>Home</button></a>
            {% endif %}

            {% if app.request.attributes.get('_route') != 'app_spinner'%}
                <a href="{{ path('app_spinner') }}"><button>Roulette</button></a>
            {% endif %}

            {% if app.request.attributes.get('_route') != 'app_duck_duck_jump'%}
                <a href="{{ path('app_duck_duck_jump') }}" data-turbo="false"><button>Duck Duck Jump</button></a>
            {% endif %}

            {% if is_granted('IS_AUTHENTICATED_REMEMBERED') %}
                <a class="link" href="{{ path('app_logout') }}"><button>Se déconnecter</button></a>
            {% else %}
                <a class="link" href="{{ path('app_login') }}"><button>Se connecter</button></a>
            {% endif %}

            {% if not is_granted('IS_AUTHENTICATED') %}
                <a class="link" href="{{ path('app_register') }}"><button>S'inscire</button></a>
            {% endif %}
        </div>
        <div class="col balance">
                {% if (app.user) %}
                   <span>Argent : <span id="nav-user-balance">{{ app.user.balance }}</span> €</span>
                {% endif %}
        </div>
    </div>
</header>